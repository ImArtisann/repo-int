# Copy this file to .env in packages/assets. Never commit .env.
# Authenticate Alchemy with `bun x alchemy login` before deploying.
ASSETS_BUCKET_NAME=__ASSETS_BUCKET_NAME__
ASSETS_HOST=
ASSETS_ZONE_ID=

# R2 S3 API credentials, scoped to read/write objects in this bucket.
# Use the same Cloudflare account as your Alchemy deployment.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
